  "findings": [
    {
      "title": "Decision · tested, not retained",
      "evidence": "POST 500 × 10 KB: 151.4 → 145.9 MiB; POST 50 × 100 KB: 109.5 → 105.8 MiB",
      "interpretation": "Tested, not retained. Memory fell 3.6% / 3.4%, but POST latency was mixed and overall request CPU roughly unchanged. Custom decoding, compatibility fallbacks, error translation and manual schema handling were not justified by these savings.",
      "optimization": "Revert direct JSON parsing; keep standard FastAPI request validation",
      "validation": "Three original Memray captures per version/workload; compare restored in-memory POST with this candidate, not the rejected spool experiment.",
      "evidence_type": "Original whole-test Memray",
      "status": "Not retained"
    },
    {
      "title": "Cost of not retaining",
      "evidence": "Foregone whole-test memory savings: POST 500 5.475 MiB (3.6%); POST 50 3.743 MiB (3.4%)",
      "interpretation": "Give up these modest memory savings and the POST 50 latency benefit observed in this repeat. Keep the simpler request path; no equivalent production RAM or latency cost has been established.",
      "optimization": "Accept the measured memory trade-off in favor of simpler validation",
      "validation": "Differences derived from the pinned fresh before/after comparison; POST 500 timing ranges overlap, so rejection is a trade-off decision, not proof of a universal slowdown.",
      "evidence_type": "Paired measurements and retention decision",
      "status": "Accepted trade-off"
    },
    {
      "title": "Why savings are limited",
      "evidence": "POST 500 parsing + model attribution: 31.3 → 28.9 MiB",
      "interpretation": "The validated dictionaries and strings still need RAM. The new parser merges parsing and validation; compare their combined attribution, not the disappearance of the old JSON label alone.",
      "optimization": "Remove an intermediate representation, not the required run data",
      "validation": "Same allocation classifier and pinned route source, with an explicit label override for the combined parser/validator stack.",
      "evidence_type": "Recorded peak allocation stacks",
      "status": "Observed"
    },
    {
      "title": "POST latency",
      "evidence": "POST 500 × 10 KB: 370.9 → 397.7 ms; POST 50 × 100 KB: 346.1 → 320.9 ms",
      "interpretation": "POST 500 × 10 KB: 7.2% higher median; mean 391.4 → 419.1 ms; POST 50 × 100 KB: 7.3% lower median; mean 408.4 → 326.4 ms. POST 500 suite medians overlap; POST 50 after-suite medians are all lower in this repeat. No uniform POST latency gain; keep slower samples.",
      "optimization": "Combined parsing and validation",
      "validation": "Six original unprofiled suites, order B–A–A–B–B–A; median of three report medians. No profiler timings used as latency.",
      "evidence_type": "Original pytest-benchmark",
      "status": "Mixed"
    },
    {
      "title": "CPU and mechanism",
      "evidence": "POST 500 × 10 KB: 0.475 → 0.466 CPU s; POST 50 × 100 KB: 0.399 → 0.404 CPU s",
      "interpretation": "Overall request CPU is mixed: POST 500 about 1.9% lower; POST 50 about 1.3% higher. Every normal POST: Request.json 1 → 0 calls; TypeAdapter.validate_json 0 → 1. Outgoing serialization and one COPY are unchanged. Rare parser-rejected requests use a compatibility fallback.",
      "optimization": "One reusable TypeAdapter; raw bytes to Run models",
      "validation": "24 accepted cold Yappi captures; fixed fixtures matched before/after. Function rows show session 1; phase CPU uses all three captures.",
      "evidence_type": "Cold Yappi",
      "status": "Observed"
    },
    {
      "title": "GET control",
      "evidence": "GET 10 KB: 40.6 → 41.5 ms; 9.226 → 9.218 MiB; GET 100 KB: 42.3 → 42.5 ms; 2.595 → 2.520 MiB",
      "interpretation": "GET code is unchanged. Its timings are a control, not a GET improvement. Memory captures include the changed POST used for seeding.",
      "optimization": "Keep GET, S3 client/session lifetimes and storage references unchanged",
      "validation": "Every cold GET still performs one S3 range read and three field decodes.",
      "evidence_type": "Original benchmarks, Yappi, Memray",
      "status": "Control"
    },
    {
