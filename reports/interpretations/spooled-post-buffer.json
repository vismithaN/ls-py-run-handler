  "findings": [
    {
      "title": "POST memory hypothesis",
      "evidence": "POST 500 \u00d7 10 KB: 151.4 \u2192 143.6 MiB (5.1% lower); POST 50 \u00d7 100 KB: 111.5 \u2192 105.6 MiB (5.3% lower)",
      "interpretation": "Memory hypothesis supported, but rejected overall: ~5% lower whole-test peak did not justify 11.7% slower POST 500. The in-memory upload implementation is restored; these numbers describe the archived experiment, not current code.",
      "optimization": "1 MiB spooled batch; one in-memory run at a time; direct seekable S3 upload",
      "validation": "Three original Memray captures per workload/version; all raw recordings preserved.",
      "evidence_type": "Original whole-test Memray",
      "status": "Not retained"
    },
    {
      "title": "POST latency trade-off",
      "evidence": "POST 500 \u00d7 10 KB: 324.6 \u2192 362.4 ms (11.7% slower); POST 50 \u00d7 100 KB: 322.7 \u2192 350.5 ms (8.6% slower)",
      "interpretation": "POST 500 is slower in all three suites. POST 50 is mixed: mean 355.8 \u2192 352.2 ms; suite ranges overlap. Do not accept the memory saving as a default without considering this latency trade-off.",
      "optimization": "Bound outgoing batch memory with temporary disk storage",
      "validation": "Three original unprofiled suites per version, order B\u2013A\u2013A\u2013B\u2013B\u2013A. No best-run selection.",
      "evidence_type": "Original unprofiled benchmark",
      "status": "Trade-off"
    },
    {
      "title": "CPU and write granularity",
      "evidence": "POST 500 \u00d7 10 KB: 0.473 \u2192 0.493 CPU s; POST 50 \u00d7 100 KB: 0.421 \u2192 0.412 CPU s",
      "interpretation": "POST 500 spool writes: 10,001 \u2192 502 calls; session-1 CPU 0.158 \u2192 0.016 s. The first prototype was 45.0% slower; grouping one run per write removes much of that overhead, not the whole trade-off.",
      "optimization": "Write per-run chunks, not every JSON token",
      "validation": "24 accepted cold Yappi captures; one rollover and one DB COPY in each POST capture.",
      "evidence_type": "Cold Yappi; prototype kept separately",
      "status": "Observed"
    },
    {
      "title": "GET control",
      "evidence": "GET 10 KB: 40.9 \u2192 41.6 ms / 9.241 \u2192 9.226 MiB; GET 100 KB: 42.7 \u2192 42.6 ms / 2.595 \u2192 2.595 MiB",
      "interpretation": "GET code is unchanged. Small timing shifts are control variation, not a GET optimization. Memray GET captures include the POST used to seed the run.",
      "optimization": "Preserve GET storage references, range read and response encoding",
      "validation": "Three benchmarks and memory captures per version; every cold GET still has one S3 range and three field decodes.",
      "evidence_type": "Original benchmark, Yappi and Memray",
      "status": "Control"
    },
    {
      "title": "Correctness and cleanup",
      "evidence": "15 tests passed \u00b7 identical JSON bytes \u00b7 SDK retry rewinds \u00b7 spill and RAM paths",
      "interpretation": "Offsets and round trips remain correct. Files close on success and failed upload; failed upload leaves no DB row. Small batches stay in RAM, large batches spill.",
      "optimization": "Seek to zero, set ContentLength, close the spool before DB COPY",
      "validation": "10 run tests plus 5 dashboard tests; only newly created local experiment databases/buckets were removed.",
      "evidence_type": "Correctness and failure checks",
      "status": "Verified"
    }
  ],
