  "finding_mode": "results",
  "findings": [
    {
      "title": "Large-batch POST latency",
      "evidence": "540.9 → 321.3 ms · 40.6% lower",
      "interpretation": "Before suite medians: 526.0–555.8 ms; after: 309.9–340.8 ms. Every after median is faster than every before median. Mean across saved rounds: 550.8 → 325.7 ms.",
      "optimization": "Transactional binary COPY for POST references",
      "validation": "Six original suites, before–after–after–before–before–after; median of three report medians per version.",
      "evidence_type": "Unprofiled original benchmarks",
      "status": "Improved"
    },
    {
      "title": "Database work",
      "evidence": "500/50 INSERTs → BEGIN + COPY + COMMIT · 3 measured dispatches",
      "interpretation": "POST 500 DB-write elapsed phase: 226.6 → 12.6 ms; POST 50: 23.6 → 4.8 ms. S3 PUT and new DB/S3 connections remain one each per POST.",
      "optimization": "Transactional binary COPY for POST references",
      "validation": "Separate fixed-fixture diagnostics: 15 requests per workload/version; all rows and S3 ranges verified outside capture. Counts are API/SQL dispatches, not wire messages; driver metadata preparation is outside this count.",
      "evidence_type": "Instrumented phase/count diagnostics",
      "status": "Observed"
    },
    {
      "title": "Smaller-batch POST",
      "evidence": "Median: 342.1 → 309.7 ms · mean: 348.0 → 369.7 ms",
      "interpretation": "Median is 9.5% lower, but suite ranges overlap and after samples include 550.5 ms and 1,011.0 ms. Mean across 15 saved rounds is 6.2% higher; do not claim uniform latency or throughput improvement.",
      "optimization": "Transactional binary COPY for POST references",
      "validation": "All raw samples kept. Cause of slow samples is not established; repeat/tail-load testing is needed before a production latency claim.",
      "evidence_type": "Unprofiled original benchmarks",
      "status": "Mixed"
    },
    {
      "title": "CPU and memory",
      "evidence": "POST 500 CPU: 0.596 → 0.469 s · memory: 151.393 → 151.393 MiB",
      "interpretation": "POST 500 cold profiled request CPU is 21.4% lower; POST 50 is only 2.0% lower. POST memory peaks are effectively unchanged. Serialization stays 6,000/600 calls; this changes database writes only.",
      "optimization": "Transactional binary COPY for POST references",
      "validation": "24 accepted cold captures, 8 original Memray recordings. INSERT/COPY counts verified in every POST CPU capture.",
      "evidence_type": "Cold Yappi and original Memray",
      "status": "Observed"
    },
    {
      "title": "Correctness and scope",
      "evidence": "15 tests passed · 120/120 diagnostic requests correct · no migration",
      "interpretation": "Duplicate IDs within a batch or against existing rows leave no partial DB rows; original rows survive and subsequent writes succeed. GET remains unchanged. Database rollback does not remove an earlier S3 upload; cross-store atomicity is not implemented.",
      "optimization": "Transactional binary COPY for POST references",
      "validation": "10 run tests plus 5 dashboard tests. Only isolated experiment resources reset and removed; no shared test-resource reset.",
      "evidence_type": "Correctness tests and saved cleanup records",
      "status": "Verified"
    }
  ],
  "limitations": [
    "Fresh before is the retained application including the GET encoding code change; that change is not counted as a selected optimization.",
    "Application change is confined to POST database insertion. GET, serialization, S3, schema and connection lifetimes are unchanged.",
    "Main latency figure is the median of three report medians; means average all saved round samples. Benchmark graph displays the first completed after report, not the aggregate or a selected best run.",
    "CPU profiles and diagnostic elapsed phases are separate instrumented passes; do not mix their timings with original unprofiled benchmark latency.",
    "Small samples and local in-process serial workloads do not establish production p95, concurrent throughput or absence of a smaller-batch tail regression.",
    "Only POST 500 has a clear repeated end-to-end improvement here. POST 50 has a faster DB phase but mixed overall latency; GET differences are control variation.",
    "Whole-test Memray peaks are not process RSS or per-request RAM.",
    "Duplicate-ID responses remain the existing HTTP 500 behavior. DB rollback is verified; cleanup of an S3 object uploaded before DB failure remains an existing limitation.",
    "Feature is uncommitted. Git revision identifies the checkout; application SHA and saved source snapshots identify the measured code."
  ],
